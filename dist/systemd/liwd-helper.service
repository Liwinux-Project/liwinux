[Unit]
Description=liwinux privileged helper
Documentation=https://github.com/Liwinux-Project/liwinux
After=dbus.service polkit.service
Wants=polkit.service

[Service]
Type=exec
BusName=id.liwinux.Helper1
ExecStart=/usr/local/bin/liwd-helper
Restart=on-failure
RestartSec=5
Environment=LIWD_LOG=info

# It runs as root, so we keep the surface narrow.
NoNewPrivileges=yes
ProtectHome=read-only
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# CapabilityBoundingSet is DELIBERATELY not set.
# `waydroid shell` runs `lxc-attach` underneath; entering the container needs
# CAP_SYS_CHROOT, CAP_SETUID, CAP_SETGID, CAP_SYS_PTRACE and more. A narrowed
# set makes the command fail SILENTLY (empty output).
# Instead of restricting capabilities we keep the interface surface narrow:
# this service exposes no general-purpose shell, only named operations.

[Install]
WantedBy=multi-user.target
