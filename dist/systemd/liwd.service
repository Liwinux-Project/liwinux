[Unit]
Description=liwinux session daemon
Documentation=https://github.com/wintone01/liwinux
# A user service: the Waydroid session must reach the Wayland display, so it
# runs in the user context rather than as root.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
ExecStart=%h/.local/bin/liwd
Restart=on-failure
RestartSec=5
Environment=LIWD_LOG=info
# Restarting the daemon must NOT KILL a running Android:
# stop only the main process and leave the children (the session) alone.
KillMode=process

[Install]
WantedBy=graphical-session.target
