<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>liwinux</vendor>
  <vendor_url>https://github.com/wintone01/liwinux</vendor_url>

  <!-- Read-only. Allowed for the user in the active session; it changes
       nothing and asking for a password would make diagnosis needlessly
       harder. -->
  <action id="id.liwinux.helper.read-property">
    <description>Read an Android system property</description>
    <description xml:lang="tr">Android sistem özelliğini oku</description>
    <message>liwinux needs to read the state of the Android container</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="id.liwinux.helper.net-diagnose">
    <description>Inspect the network configuration</description>
    <message>liwinux needs to run network diagnostics</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="id.liwinux.helper.foreground-app">
    <description>Query the foreground Android app</description>
    <message>liwinux needs the foreground app in order to pick the right profile</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="id.liwinux.helper.performance">
    <description>Read frame timing data</description>
    <message>liwinux needs to measure performance</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- A developer visual aid; it does not affect system security. -->
  <action id="id.liwinux.helper.debug-overlay">
    <description>Toggle the Android touch indicator</description>
    <message>liwinux needs the touch indicator for calibration</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- It CHANGES the firewall: administrator authentication is mandatory.
       auth_admin_keep avoids asking for the password again on consecutive
       repair steps without making the authorization permanent. -->
  <action id="id.liwinux.helper.net-repair">
    <description>Repair firewall rules for Waydroid</description>
    <message>liwinux needs authorization to change firewall rules</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="id.liwinux.helper.read-log">
    <description>Read the Android log</description>
    <description xml:lang="en">Read Android log</description>
    <message>The Android log will be read to diagnose application hangs</message>
    <message xml:lang="en">Reading the Android log to diagnose application hangs</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="id.liwinux.helper.restart-audio">
    <description>Restart a wedged audio HAL</description>
    <description xml:lang="en">Restart wedged audio HAL</description>
    <message>The wedged audio subsystem will be restarted</message>
    <message xml:lang="en">Restarting the wedged audio subsystem</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <!-- Hands over a WRITE handle to the touch pipe.

       Deliberately NOT auth_admin: this permission lets the user send
       touches to their own Waydroid session, which the user in the active
       session can already do with their mouse. Asking for a password would
       obstruct every keymapper start and protect nothing new in return.

       The scope stays narrow regardless: only the ACTIVE local session,
       only the touch pipe; the helper exposes no general write interface. -->
  <action id="id.liwinux.helper.touch-pipe">
    <description>Access the Android touch pipe</description>
    <description xml:lang="en">Access the Android touch pipe</description>
    <message>liwinux needs to send touches to Android for key mapping</message>
    <message xml:lang="en">liwinux needs to send touch input to Android for key mapping</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

</policyconfig>
